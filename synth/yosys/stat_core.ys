# Quick local generic synthesis of llaccel_core (no liberty): gate-level cell
# counts for a first look at relative area of v1 vs v2. Real PPA comes from ORFS.
#   FUSION=1 yosys -s synth/yosys/stat_core.ys
plugin -i slang
read_slang -f rtl/filelist.f --top llaccel_core -G EPILOGUE_FUSION=$FUSION
hierarchy -top llaccel_core -check
synth -top llaccel_core -flatten
opt_clean
stat -width
