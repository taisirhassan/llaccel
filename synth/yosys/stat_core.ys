# Yosys command template, rendered by synth/run_yosys.sh.
# Run: synth/run_yosys.sh stat v1|v2
plugin -i slang
read_slang -f rtl/filelist.f --top llaccel_core -G EPILOGUE_FUSION=@FUSION@ -G DMA_MAX_OUTSTANDING=@DMA_DEPTH@
hierarchy -top llaccel_core -check
synth -top llaccel_core -flatten
opt_clean
check -assert
stat -width
